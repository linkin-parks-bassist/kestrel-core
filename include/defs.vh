`define CLOCK_SPEED 112500000
`define SAMPLE_RATE 44100
`define CYCLES_PER_SAMPLE (`CLOCK_SPEED/`SAMPLE_RATE)

`define FILTER_REQ_TYPE_FILTER		4'b0000
`define FILTER_REQ_TYPE_FCASC		4'b0001
`define FILTER_REQ_TYPE_SVF			4'b0010
`define FILTER_REQ_TYPE_SVF_LOW		4'b0011
`define FILTER_REQ_TYPE_SVF_BAND	4'b0100
`define FILTER_REQ_TYPE_SVF_HIGH	4'b0101
`define FILTER_REQ_TYPE_POLY		4'b1000
